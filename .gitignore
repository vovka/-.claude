# Allowlist: ignore everything, then opt in what is shared config.
# ~/.claude is mostly runtime state, caches, transcripts and credentials.
/*
!/.gitignore
!/CLAUDE.md
!/agents/
!/agent-memory/
!/commands/
!/hooks/
!/skills/
!/statusline-command.sh
!/quota.sh

# Managed by claude.ai sync, not hand-edited
/skills/synced/
!/.gitmodules
!/local-plugins/
